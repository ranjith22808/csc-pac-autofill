
{
  "manifest_version": 3,
  "name": "CSC PAC Autofill",
  "description": "Fill Client Operator ID, Customer and Wallet PIN on Digital Seva PAC Generate page.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://digitalseva.csc.gov.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CSC PAC Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "csc-pac-autofill@ranjith22808.github.io",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://digitalseva.csc.gov.in/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
